<script language="JavaScript">
function playah(s)
{
  playerFrame.innerHTML = "<embed src='"+s+"'></embed>";
}
function giffer(s)
{
  var o = event.srcElement;
  //o.style.textDecoration = "underline";
  // o.style.backgroundColor = "yellow";
  o.style.color = "yellow";
  playerFrame.innerHTML = "<IMG WIDTH=220 SRC='images/"+s+"'>";
}
function outtie()
{
  var o = event.srcElement;
  o.style.color = "white";
}
</script>

