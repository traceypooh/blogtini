#!/bin/sh -eu

# blogtini build step.  See `build.js` for what it does.
#
# GitHub Actions run this in an alpine linux container with the `deno` binary installed.
# You can run it locally, too, from the top of your site repo, eg:  ../blogtini/bin/build

deno run --no-lock --allow-read=. --allow-write=. --allow-env=GITHUB_REPOSITORY \
  --allow-import=esm.ext.archive.org:443 "$(dirname "$0")/build.js" "$@"

# in GitHub Actions only: cleanup, remove `.git/` etc. before the site gets uploaded
if [ "${GITHUB_ACTIONS:-}" = true ]; then
  rm -rf  _blogtini  .[^.]*
fi
